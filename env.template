# Environment configuration template for 4DGS MV Pipeline
#
# Copy this file to .env and fill in your values
# Usage in notebook: load_dotenv() or set as environment variables

# Root workspace directory (on Google Drive)
ROOT=/content/drive/MyDrive/mvp_4dgs_job

# Debug mode (set to True for lightweight shim, False for real 4DGS)
DEBUG_SHIM=True

# SAM2 checkpoint path (optional - will use placeholder if not provided)
SAM_CHECKPOINT=

# RVM checkpoint path (optional - will use placeholder if not provided)
RVM_CHECKPOINT=

# 4DGS repository path (required if DEBUG_SHIM=False)
FOURGS_REPO=/content/4dgs_repo

# COLMAP binary path (optional - will use apt installed version or fallback)
COLMAP_BIN=/usr/local/bin/colmap

# Optional: API keys for cloud services (do NOT commit real keys)
# Example: WANDB_API_KEY=your_key_here
WANDB_API_KEY=

# Job identifier (optional)
JOB_ID=colab-demo

# Frame extraction settings
FPS=30
MAX_FRAMES=

# COLMAP settings (optional)
COLMAP_QUALITY=high
COLMAP_CAMERA_MODEL=PINHOLE

# GS shim settings (for DEBUG_SHIM=True)
SHIM_GRID_SIZE=600,300
SHIM_Z_DEPTH=4.0

# Output settings
OUTPUT_FPS=30
OUTPUT_WIDTH=1920
OUTPUT_HEIGHT=1080

# Logging level
LOG_LEVEL=INFO
